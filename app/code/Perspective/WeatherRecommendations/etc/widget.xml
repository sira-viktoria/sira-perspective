<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget id="perspective_weather_recommendation_products_list"
            class="Perspective\WeatherRecommendations\Block\Widget\RecommendationProducts">
        <label>Weather Recommendation Products  Widget</label>
        <description>Displays recommended products based on temperature</description>
        <parameters>
            <parameter name="template" xsi:type="select" required="true" visible="true">
                <label>Template</label>
                <options>
                    <option name="default"  selected="true"
                            value="Perspective_WeatherRecommendations::widget/weather_info.phtml">
                        <label translate="true">Default Template</label>
                    </option>
                </options>
            </parameter>
        </parameters>
    </widget>
</widgets>

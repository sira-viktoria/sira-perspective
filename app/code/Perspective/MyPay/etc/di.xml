<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Payment\Model\MethodList">
        <plugin name="perspective_mypay_restrict_payment_methods"
                type="Perspective\MyPay\Plugin\Model\PaymentMethodListRestrict"
                sortOrder="10"/>
    </type>
    <type name="Magento\Quote\Model\Quote\Address">
        <plugin name="perspective_restrict_shipping_methods"
                type="Perspective\MyPay\Plugin\Model\Quote\AddressRestrict"
                sortOrder="10"/>
    </type>
</config>

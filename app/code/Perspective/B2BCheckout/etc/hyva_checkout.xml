        xsi:noNamespaceSchemaLocation="urn:magento:module:Hyva_Checkout:etc/hyva_checkout.xsd">
    <checkout name="b2b" label="B2B Checkout" parent="default">
        <step name="company" label="Company Information" route="company" after="shipping" >

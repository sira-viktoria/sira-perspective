<?xml version="1.0" encoding="UTF-8"?>
<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="AdminCreateVotingActionGroup">
        <arguments>
            <argument name="votingTitle" type="string" defaultValue="Complex MFTF Voting"/>
        </arguments>

        <click selector="{{AdminVotingFormSection.marketingMenu}}" stepKey="clickMarketing"/>
        <click selector="{{AdminVotingFormSection.votingGridLink}}" stepKey="clickVotingLink"/>
        <waitForPageLoad stepKey="waitForGridLoad"/>
        <click selector="{{AdminVotingFormSection.addNewVotingButton}}" stepKey="clickAddNew"/>
        <waitForElementVisible selector="{{AdminVotingFormSection.title}}" stepKey="waitForFormVisible"/>

        <fillField selector="{{AdminVotingFormSection.title}}" userInput="{{votingTitle}}" stepKey="fillTitle"/>
        <fillField selector="{{AdminVotingFormSection.description}}" userInput="Testing Description" stepKey="fillDescription"/>
        <selectOption selector="{{AdminVotingFormSection.managementType}}" userInput="Manual" stepKey="selectManagementType"/>
        <click selector="{{AdminVotingFormSection.statusToggle}}" stepKey="toggleStatusOn"/>

        <scrollTo selector="{{AdminVotingFormSection.optionsContainer}}" stepKey="scrollToOptions"/>

        <click selector="{{AdminVotingFormSection.addAnswerButton}}" stepKey="addFirst"/>
        <click selector="{{AdminVotingFormSection.addAnswerButton}}" stepKey="addSecond"/>

        <fillField selector="{{AdminVotingFormSection.answerTitle('0')}}" userInput="Option with Product 1" stepKey="fillTitle1"/>
        <fillField selector="{{AdminVotingFormSection.answerDescription('0')}}" userInput="This option is linked to a product" stepKey="fillDesc1"/>
        <selectOption selector="{{AdminVotingFormSection.answerProduct('0')}}" userInput="WT04 (Nona Fitness Tank)" stepKey="selectProduct1"/>
        <fillField selector="{{AdminVotingFormSection.answerPercent('0')}}" userInput="50" stepKey="fillPercent1"/>

        <fillField selector="{{AdminVotingFormSection.answerTitle('1')}}" userInput="Option with Product 2" stepKey="fillTitle2"/>
        <selectOption selector="{{AdminVotingFormSection.answerProduct('1')}}" userInput="24-MB01 (Joust Duffle Bag)" stepKey="selectProduct2"/>
        <fillField selector="{{AdminVotingFormSection.answerPercent('1')}}" userInput="100" stepKey="fillPercent2"/>

        <wait time="3" stepKey="testWait1"/>

        <click selector="{{AdminVotingFormSection.saveButton}}" stepKey="clickSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector="{{AdminVotingFormSection.successMessage}}" userInput="The data has been saved." stepKey="seeSuccessMessage"/>

        <wait time="5" stepKey="testWait2"/>
    </actionGroup>
</actionGroups>

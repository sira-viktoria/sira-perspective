<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="perspective_tab" translate="label" sortOrder="1">
            <label>Perspective</label>
        </tab>

        <section id="custom_price_attribute" sortOrder="111" translate="label" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Custom Price Config</label>
            <tab>perspective_tab</tab>
            <resource>Perspective_CustomPriceAttribute::config</resource>

            <group id="general_settings" sortOrder="1" translate="label" type="text" showInDefault="1" showInWebsite="1" showInStore="1">
                <attribute type="expanded">1</attribute>
                <label>General Settings</label>
                <field id="price_increase_percentage" sortOrder="1" translate="label" type="text"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Price Increase Percentage (%)</label>
                    <validate>validate-digits validate-not-negative-number validate-digits-range</validate>
                    <comment>Value must be greater then 0</comment>
                </field>
            </group>
        </section>
    </system>
</config>

<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="perspective_customer_reference" resource="default" engine="innodb" comment="Customer Reference Storage">
        <column xsi:type="int" name="entity_id" nullable="false" identity="true" unsigned="true" comment="ID"/>
        <column xsi:type="int" name="quote_id" nullable="false" unsigned="true" comment="Quote Id"/>
        <column xsi:type="text" name="customer_reference" nullable="true" comment="Customer Reference"/>
        <constraint xsi:type="primary"
                    referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
</schema>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote">
        <column name="is_weather_insurance" xsi:type="smallint" nullable="false" default="0" comment="Is Perspective Weather Insurance"/>
        <column  name="weather_insurance" xsi:type="decimal" scale="4" precision="20" unsigned="false"
                 nullable="true" default="0" comment="Perspective Weather Insurance"/>
    </table>
    <table name="sales_order">
        <column  name="weather_insurance" xsi:type="decimal" scale="4" precision="20" unsigned="false"
                nullable="true" default="0" comment="Perspective Weather Insurance"/>
    </table>
</schema>

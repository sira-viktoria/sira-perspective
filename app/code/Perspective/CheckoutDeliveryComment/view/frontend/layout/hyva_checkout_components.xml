<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
>
    <body>
            <referenceContainer name="hyva.checkout.navigation.right">

                <block name="checkout.order-delivery-comment" after="checkout.place-order"
                       template="Perspective_CheckoutDeliveryComment::magewire/component/order-delivery-comment.phtml">
                    <action method="setTitle">
                        <argument name="title" translate="true" xsi:type="string">Delivery</argument>
                    </action>
                    <arguments>
                        <argument name="magewire" xsi:type="object">
                            \Perspective\CheckoutDeliveryComment\Magewire\Checkout\OrderDeliveryComment
                        </argument>
                    </arguments>
                </block>
            </referenceContainer>
    </body>
</page>


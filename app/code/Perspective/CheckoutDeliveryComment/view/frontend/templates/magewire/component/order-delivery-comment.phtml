<?php
/** @var Template $block */
/** @var OrderDeliveryComment $magewire */
/** @var Escaper $escaper */
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Perspective\CheckoutDeliveryComment\Magewire\Checkout\OrderDeliveryComment;
?>

<div id="order-delivery-comment-container" class="border-t border-gray-400 pt-4"
     x-data="{ isCommentValid: false, isVisible: true}"
     @checkout:order-delivery-comment:toggle-place-order.window="isCommentValid = $event.detail.disabled"
     x-show="isVisible">
    <div class="text-green-500 space-x-4 text-sm">
        <span class="hidden"
              wire:loading
              wire:target="orderDeliveryComment"
              wire:loading.class.remove="hidden">
            ...<?= $escaper->escapeHtml(__('saving!')) ?>
        </span>

        <?php if ($magewire->saved): ?>
            <span wire:target="orderDeliveryComment" class="flex" wire:loading.class="hidden">
                <?= $escaper->escapeHtml(__('Saved successfully!')) ?>
            </span>
        <?php endif ?>
    </div>

    <div class="field field-reserved">
        <textarea
            id="order_delivery_comment"
            type="text"
            name="order_delivery_comment"
            data-validate='{"validate-delivery-comment": true}'
            wire:model.live.debounce.750ms="orderDeliveryComment"
            wire:key="order-delivery-comment-key"
            placeholder="<?= $escaper->escapeHtmlAttr(__('Order Delivery Comment')) ?>"
            class="block w-full shadow-sm border-gray-300 rounded-md resize-y">
        </textarea>
    </div>

    <template x-if="isCommentValid">
        <p class="text-red-600 text-sm mt-1">Delivery Comment must not contain the word "test".</p>
    </template>

    <script>
        window.addEventListener('DOMContentLoaded', () => {
            if (window.hyva && window.hyva.formValidation) {
                hyva.formValidation.addRule('validate-delivery-comment', function(value, options, field, context) {
                    if (!value) {
                        return true;
                    }

                    return !/test/i.test(value);
                });
            }

            window.addEventListener('checkout:order-delivery-comment:toggle-place-order', (event) => {
                const shouldDisable = event.detail.disabled;
                const placeOrderButtons = document.querySelectorAll(
                    'button[id^="place-order"], button.btn-place-order, .payment-method-submit button'
                );

                placeOrderButtons.forEach(button => {
                    if (shouldDisable) {
                        button.setAttribute('disabled', 'disabled');
                        button.classList.add('opacity-50', 'cursor-not-allowed');
                        if (!button.dataset.originalText) {
                            button.dataset.originalText = button.innerText;
                        }
                        button.innerText = 'Fix Delivery Comment First';
                    } else {
                        button.removeAttribute('disabled');
                        button.classList.remove('opacity-50', 'cursor-not-allowed');
                        if (button.dataset.originalText) {
                            button.innerText = button.dataset.originalText;
                        }
                    }
                });
            });
        });

        window.addEventListener('checkout:init:evaluation', () => {
            hyvaCheckout.evaluation.registerProcessor('orderDeliveryComment', (component, el, result) => {
                const blockComment = document.getElementById('order-delivery-comment-container');

                if (blockComment) {
                    const alpineData = Alpine.$data(blockComment);
                    alpineData.isVisible = !!result.arguments.details.showComment;
                }
                return result.result;
            });
        });
    </script>
</div>

<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="sales_order" resource="sales" comment="Sales Order">
        <column xsi:type="boolean" name="is_reservation"
                nullable="true" default="0" comment="Is Reservation Order"/>
    </table>
    <table name="sales_order_grid" resource="sales" comment="Sales Order Grid">
        <column xsi:type="boolean" name="is_reservation"
                nullable="true" default="0" comment="Is Reservation Order"/>
    </table>
</schema>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Payment\Model\CcGenericConfigProvider">
        <arguments>
            <argument name="methodCodes" xsi:type="array">
                <item name="perspective_liqpay" xsi:type="const">
                    Perspective\LiqPay\Model\Payment\LiqPay::METHOD_CODE
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\App\Request\CsrfValidator">
        <plugin name="perspective_csrf_for_callback" sortOrder="10"
                type="Perspective\LiqPay\Plugin\Framework\App\Request\CsrfValidator" />
    </type>
</config>

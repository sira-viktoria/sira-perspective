<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="shipping">
            <group id="perspectiveshipping" translate="label" sortOrder="999" showInDefault="1" showInWebsite="1" showInStore="1">
                <group id="update_price" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Updating Perspective Shipping Method Price</label>
                    <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1">
                        <label>Enable Module</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    </field>
                    <field id="min_shipping_cost" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" canRestore="1">
                        <label>Minimum Shipping Cost</label>
                        <comment>The price that needs to be rounded.</comment>
                        <validate>validate-number validate-zero-or-greater</validate>
                        <depends>
                            <field id="enabled">1</field>
                        </depends>
                    </field>
                </group>
            </group>
        </section>
    </system>
</config>

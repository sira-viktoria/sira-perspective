<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="hyva.checkout.navigation.right">
            <block class="Magento\Framework\View\Element\Template"
                   name="grand.total-validation.notice"
                   template="Perspective_CheckoutPlaceOrderService::checkout/total-validation-notice.phtml"
                   after="-">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Perspective\CheckoutPlaceOrderService\Magewire\Checkout\GrandTotalValidation
                    </argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>

</page>

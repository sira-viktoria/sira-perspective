<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="perspective_widget_conditions" resource="default" engine="innodb" comment="Widget Conditions Table">
        <column xsi:type="int" name="condition_id" unsigned="true" nullable="false" identity="true" comment="Condition ID"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="Condition Name"/>
        <column xsi:type="text" name="conditions" nullable="true" comment="Conditions"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="condition_id"/>
        </constraint>
    </table>
</schema>
